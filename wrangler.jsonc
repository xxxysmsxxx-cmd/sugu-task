{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sugu-task",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-18",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "sugu-task", "database_id": "REPLACE_AFTER_D1_CREATE" }
  ],
  "ai": { "binding": "AI" }
}
