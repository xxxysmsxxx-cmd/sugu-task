{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sugu-task",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "sugu-task", "database_id": "69d49700-6e99-401f-bd9e-4c55e39c76bd" }
  ],
  "ai": { "binding": "AI" }
}
